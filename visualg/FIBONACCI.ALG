algoritmo "Fibonacci"
var
   NA1, NA2, NA, S : Inteiro
inicio
      NA1 <- 1
      NA2 <- 1
      Escreva (NA1)
      Escreva (NA2)
      
      Para S <- 1 ate 13 faca
           NA <- NA1 + NA2
           Escreva(NA)
           NA1 <- NA2
           NA2 <- NA
      FimPara
fimalgoritmo